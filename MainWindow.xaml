<Window x:Class="TECNO.GalleryBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TECNO Gallery Bridge" Height="760" Width="1300" MinHeight="550" MinWidth="1020" Background="#0D111A" Foreground="#EEF3FC" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#151D2B"/><Setter Property="Foreground" Value="#EDF2FB"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="12" Background="#2563EB" Margin="0,0,13,0"><Grid><Path Data="M 10,25 L 19,12 L 28,25 L 37,12" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="T" FontWeight="Bold" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel><TextBlock Text="TECNO Gallery Bridge" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Your Android gallery, directly on Windows" Foreground="#A7B3C7" FontSize="13"/></StackPanel></StackPanel>
      <Button Content="Refresh device" Click="Refresh_Click" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="20,0,0,0"/>
      <Button x:Name="StopScanButton" Content="Stop scan" Click="StopScan_Click" Visibility="Collapsed" Background="#475569" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="12,0,0,0"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#151D2B" CornerRadius="12" Padding="16" Margin="0,0,0,18">
      <DockPanel><TextBlock x:Name="DeviceText" Text="Connect and unlock your phone, then choose File Transfer (MTP)." VerticalAlignment="Center" FontSize="14"/><TextBlock DockPanel.Dock="Right" Text="USB • MTP" HorizontalAlignment="Right" Foreground="#6EE7B7"/></DockPanel>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <StackPanel Background="#151D2B" Margin="0,0,16,0">
        <TextBlock Text="LIBRARY" Margin="16,22,0,14" Foreground="#91A1BA" FontWeight="SemiBold"/>
        <Button Content="All media" Tag="All" Click="Filter_Click" Margin="12,0,12,8"/>
        <Button Content="Screen recordings" Tag="Recordings" Click="Filter_Click" Margin="12,0,12,8"/>
        <Button Content="Videos" Tag="Videos" Click="Filter_Click" Margin="12,0,12,8"/>
        <Button Content="Photos" Tag="Photos" Click="Filter_Click" Margin="12,0,12,8"/>
      </StackPanel>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SectionText" Text="All media" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Search_Changed" Height="34" Padding="9,6" Background="#202B3E" Foreground="White" BorderBrush="#40516A" ToolTip="Search filename or folder"/><ComboBox x:Name="SortBox" Grid.Column="2" SelectionChanged="Sort_Changed" SelectedIndex="0" Height="34" Margin="8,0,8,0" Background="#202B3E" Foreground="#111827"><ComboBoxItem Content="Newest first"/><ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Name A–Z"/></ComboBox><TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Center" Foreground="#99A9C2"/></Grid>
        <ListBox x:Name="MediaList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="Media_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#29354A" BorderThickness="0,0,0,1" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><Border Background="#26364E" Width="58" Height="52" CornerRadius="8"><Grid><TextBlock Text="{Binding TypeIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#93C5FD" FontSize="18"/><Image Source="{Binding Thumbnail}" ToolTip="{Binding ThumbnailError}" Stretch="UniformToFill" Loaded="Thumbnail_Loaded"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Folder}" Foreground="#91A1BA" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding SizeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B8C5D9"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Border Grid.Column="2" Background="#151D2B" Margin="16,0,0,0" Padding="16" CornerRadius="12"><StackPanel><TextBlock Text="PREVIEW" Foreground="#91A1BA" FontWeight="SemiBold" Margin="0,0,0,12"/><Border Height="240" Background="#202B3E" CornerRadius="8"><Grid><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="PreviewPlaceholder" Text="Select a photo or video" Foreground="#AAB9CD" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Border><ProgressBar x:Name="PreviewLoading" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,8,0,0"/><TextBlock x:Name="PreviewName" Text="No file selected" Margin="0,18,0,5" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PreviewDetails" Text="Select a photo to preview, or save a video and open it in Windows." TextWrapping="Wrap" Foreground="#A7B3C7" FontSize="12"/><Button x:Name="PlayButton" Content="Save &amp; open in Windows player" Click="Play_Click" Margin="0,16,0,0" Visibility="Collapsed"/><Button x:Name="OpenSavedButton" Content="Open save folder" Click="OpenFolder_Click" Margin="0,12,0,0" Background="#344156"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="3" Background="#151D2B" Padding="14" Margin="0,18,0,0" CornerRadius="12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready to connect"/><ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed" Height="5" Margin="0,8,20,0"/><ProgressBar x:Name="TransferProgress" Height="5" Margin="0,8,20,0" Minimum="0" Maximum="100" Value="0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="SavePathText" Width="170" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#A7B3C7" TextTrimming="CharacterEllipsis"/><Button Content="Choose save folder" Background="#344156" Click="ChooseFolder_Click"/><Button x:Name="SaveButton" Content="Save selected to PC" Click="Save_Click"/></StackPanel></Grid>
    </Border>
  </Grid>
</Window>
